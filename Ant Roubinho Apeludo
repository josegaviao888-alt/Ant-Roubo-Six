-- Lógica da Tela de Carregamento (Exatos 15 segundos)
task.spawn(function()
    local totalDuration = 15
    local steps = 100
    local interval = totalDuration / steps

    for i = 1, steps do
        task.wait(interval)
        LoadingLabel.Text = "Carregando: " .. i .. "%"
        ProgressBar.Size = UDim2.new(i / 100, 0, 1, 0)
    end

    LoadingLabel.Visible = false
    ProgressBarBg.Visible = false
    
    KeyInput.Visible = true
    VerifyBtn.Visible = true
end)

