    local function FindBall()
        if CachedBall and CachedBall:IsDescendantOf(workspace) then
            return CachedBall
        end
        for _, obj in ipairs(workspace:GetChildren()) do
            if not Players:GetPlayerFromCharacter(obj) then 
                for _, subObj in ipairs(obj:GetDescendants()) do
                    if subObj:IsA("BasePart") and subObj.Shape == Enum.PartType.Ball then
                        local name = subObj.Name:lower()
                        if (name:find("ball") or name:find("bola") or name:find("soccer") or name:find("football")) then
                            CachedBall = subObj
                            return subObj
                        end
                    end
                end
            end
        end
        return nil
    end

    local function IsInDispute(ball)
        if not ball then return false end
        local speed = ball.AssemblyLinearVelocity.Magnitude
        local height = ball.Position.Y
        return (speed > 10 or height > 5)
    end

    local function TrySteal()
        if not Enabled then return end
        if os.clock() - LastTeleport < Cooldown then return end
        
        local ball = FindBall()
        if not ball then
            Status.Text = "Procurando bola..."
            return
        end
        
        if not IsInDispute(ball) then
            Status.Text = "Aguardando disputa..."
            return
        end
        
        local char = LocalPlayer.Character
        if not char then return end
        
        local target = char:FindFirstChild(TargetPart)
        if not target then return end
        
        local pos = target.Position + Vector3.new(0, 2, 0)
        ball.Anchored = true
        ball.Position = pos
        ball.Anchored = false
        ball.AssemblyLinearVelocity = Vector3.zero
        
        LastTeleport = os.clock()
        
        local flash = Instance.new("Part")
        flash.Shape = Enum.PartType.Ball
        flash.Size = Vector3.new(2, 2, 2)
        flash.Transparency = 0.3
        flash.Color = Color3.fromRGB(255, 50, 200)
        flash.Material = Enum.Material.Neon
        flash.Anchored = true
        flash.CanCollide = false
        flash.Position = pos
        flash.Parent = workspace
        
        local tween = TweenService:Create(flash, TweenInfo.new(0.3), {
            Transparency = 1,
            Size = Vector3.new(0.1, 0.1, 0.1)
        })
        tween:Play()
        
        Debris:AddItem(flash, 0.3)
        
        local name = TargetPart == "Head" and "CABEÇA" or "BUNDA"
        Status.Text = "⚡ Puxado para " .. name .. "!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 200)
        
